<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--       HEADING STYLES      -->
    <!-- H1 -->
    <Style x:Key="H1" TargetType="Label">
        <Setter Property="FontFamily" Value="PublicSansBold" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="TextColor" 
            Value="{AppThemeBinding Light={StaticResource Neutral-900}, Dark={StaticResource Neutral-100}}" />
    </Style>

    <!-- H2 -->
    <Style x:Key="H2" TargetType="Label">
        <Setter Property="FontFamily" Value="PublicSansBold" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="TextColor" 
            Value="{AppThemeBinding Light={StaticResource Neutral-900}, Dark={StaticResource Neutral-100}}" />
    </Style>

    <!-- H3 -->
    <Style x:Key="H3" TargetType="Label">
        <Setter Property="FontFamily" Value="PublicSansRegular" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="TextColor" 
            Value="{AppThemeBinding Light={StaticResource Neutral-900}, Dark={StaticResource Neutral-100}}" />
    </Style>

    <!--        BODY STYLES        -->
    <!-- Body Large -->
    <Style x:Key="BodyLarge" TargetType="Label">
        <Setter Property="FontFamily" Value="NotoSansRegular" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="TextColor" 
            Value="{AppThemeBinding Light={StaticResource Neutral-700}, Dark={StaticResource Neutral-300}}" />
    </Style>

    <!-- Body Medium -->
    <Style x:Key="BodyMedium" TargetType="Label">
        <Setter Property="FontFamily" Value="NotoSansRegular" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" 
            Value="{AppThemeBinding Light={StaticResource Neutral-700}, Dark={StaticResource Neutral-300}}" />
    </Style>

    <!-- Body Small -->
    <Style x:Key="BodySmall" TargetType="Label">
        <Setter Property="FontFamily" Value="NotoSansLight" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" 
            Value="{AppThemeBinding Light={StaticResource Neutral-700}, Dark={StaticResource Neutral-300}}" />
    </Style>

    <!--        LABEL STYLES       -->
    <!-- Label Default -->
    <Style x:Key="LabelDefault" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" 
            Value="{AppThemeBinding Light={StaticResource Neutral-900}, Dark={StaticResource Neutral-100}}" />
    </Style>

    <!-- Label Light -->
    <Style x:Key="LabelLight" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansLight" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" 
            Value="{AppThemeBinding Light={StaticResource Neutral-700}, Dark={StaticResource Neutral-300}}" />
    </Style>

    <!-- Label Bold -->
    <Style x:Key="LabelBold" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" 
            Value="{AppThemeBinding Light={StaticResource Neutral-900}, Dark={StaticResource Neutral-100}}" />
    </Style>

    <!--       BUTTON STYLE        -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="FontFamily" Value="PublicSansBold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="BackgroundColor" Value="{StaticResource Primary-500}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,10" />
    </Style>

</ResourceDictionary>
