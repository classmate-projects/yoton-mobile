<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!--        PRIMARY BLUE       -->
    <Color x:Key="Primary-900">#003A80</Color>
    <Color x:Key="Primary-700">#0055CC</Color>
    <Color x:Key="Primary-500">#0A6CFF</Color>
    <Color x:Key="Primary-300">#66A6FF</Color>
    <Color x:Key="Primary-100">#D6E7FF</Color>

    <!--       SECONDARY TEAL      -->
    <Color x:Key="Secondary-900">#004444</Color>
    <Color x:Key="Secondary-700">#006F6F</Color>
    <Color x:Key="Secondary-500">#008C8C</Color>
    <Color x:Key="Secondary-300">#4DB8B8</Color>
    <Color x:Key="Secondary-100">#CCEEEE</Color>

    <!--       TERTIARY ORANGE     -->
    <Color x:Key="Tertiary-900">#732F00</Color>
    <Color x:Key="Tertiary-700">#A34700</Color>
    <Color x:Key="Tertiary-500">#D95A00</Color>
    <Color x:Key="Tertiary-300">#FF9A4D</Color>
    <Color x:Key="Tertiary-100">#FFE1CC</Color>

    <!--         NEUTRAL GRAY      -->
    <Color x:Key="Neutral-900">#1C1F23</Color>
    <Color x:Key="Neutral-700">#2A2E33</Color>
    <Color x:Key="Neutral-500">#4A4F55</Color>
    <Color x:Key="Neutral-300">#7A8088</Color>
    <Color x:Key="Neutral-100">#D5D7DA</Color>

    <!--          BRUSHES          -->

    <!-- Primary Brushes -->
    <SolidColorBrush x:Key="Primary900Brush" Color="{StaticResource Primary-900}" />
    <SolidColorBrush x:Key="Primary700Brush" Color="{StaticResource Primary-700}" />
    <SolidColorBrush x:Key="Primary500Brush" Color="{StaticResource Primary-500}" />
    <SolidColorBrush x:Key="Primary300Brush" Color="{StaticResource Primary-300}" />
    <SolidColorBrush x:Key="Primary100Brush" Color="{StaticResource Primary-100}" />

    <!-- Secondary Brushes -->
    <SolidColorBrush x:Key="Secondary900Brush" Color="{StaticResource Secondary-900}" />
    <SolidColorBrush x:Key="Secondary700Brush" Color="{StaticResource Secondary-700}" />
    <SolidColorBrush x:Key="Secondary500Brush" Color="{StaticResource Secondary-500}" />
    <SolidColorBrush x:Key="Secondary300Brush" Color="{StaticResource Secondary-300}" />
    <SolidColorBrush x:Key="Secondary100Brush" Color="{StaticResource Secondary-100}" />

    <!-- Tertiary Brushes -->
    <SolidColorBrush x:Key="Tertiary900Brush" Color="{StaticResource Tertiary-900}" />
    <SolidColorBrush x:Key="Tertiary700Brush" Color="{StaticResource Tertiary-700}" />
    <SolidColorBrush x:Key="Tertiary500Brush" Color="{StaticResource Tertiary-500}" />
    <SolidColorBrush x:Key="Tertiary300Brush" Color="{StaticResource Tertiary-300}" />
    <SolidColorBrush x:Key="Tertiary100Brush" Color="{StaticResource Tertiary-100}" />

    <!-- Neutral Brushes -->
    <SolidColorBrush x:Key="Neutral900Brush" Color="{StaticResource Neutral-900}" />
    <SolidColorBrush x:Key="Neutral700Brush" Color="{StaticResource Neutral-700}" />
    <SolidColorBrush x:Key="Neutral500Brush" Color="{StaticResource Neutral-500}" />
    <SolidColorBrush x:Key="Neutral300Brush" Color="{StaticResource Neutral-300}" />
    <SolidColorBrush x:Key="Neutral100Brush" Color="{StaticResource Neutral-100}" />
</ResourceDictionary>