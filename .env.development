# Loaded by `npm start`. Left unset on purpose: src/config/env.ts then falls back to the local
# API on the host machine (Android emulator -> http://10.0.2.2:5205, iOS simulator -> localhost).
# To test on a physical phone, create .env.development.local (git-ignored) with your computer's
# LAN address, e.g.
#   EXPO_PUBLIC_API_URL=http://192.168.1.20:5205
#   EXPO_PUBLIC_WEB_URL=http://192.168.1.20:3000
