<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Yoton_Mobile.Pages.WelcomePage"
             NavigationPage.HasNavigationBar="False">
    <Grid RowDefinitions="1*, 4*, 2*, 1*"
          Padding="15">

        <!--        TOP BACKGROUND         -->
        <Grid Grid.Row="0">
            <StackLayout VerticalOptions="Center">
                <Label Text="Yoton Health"
                       HorizontalOptions="Center"
                       VerticalOptions="Start"
                       Style="{StaticResource H1}" />
                <Label Text="Welcome to Yoton Health"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       Style="{StaticResource H2}"
                       Margin="0,10,0,0" />
                
            </StackLayout>
        </Grid>
        <!--         GET STARTED           -->
        <StackLayout Grid.Row="1">
            <Label Text="Experience outpatient excellence through precision medicine and streamlined digital healthcare tailored for your recovery."
                   HorizontalTextAlignment="Center"
                   Style="{StaticResource BodyMedium}"/>
        </StackLayout>
        
        <!--      ICONS (Clinical/Secure)  -->
        <Grid Grid.Row="2"
              RowDefinitions="1*,1*"
              ColumnDefinitions="*,*"
              HorizontalOptions="Fill"
              Margin="30,10,30,10">
            <Button Grid.Row="0"
                    Grid.ColumnSpan="2"
                    Text="Get Started"
                    Command="{Binding LoginCommand}" 
                    Style="{StaticResource PrimaryButton}"
                    Margin="30,20" />
            <Label Text="Clinical Grade"
                   Grid.Row="1"
                   Grid.Column="0"
                   Style="{StaticResource LabelDefault}"/>
            <Label Text="Secure"
                   Grid.Row="1"
                   Grid.Column="1"
                   Style="{StaticResource LabelDefault}"/>

        </Grid>
        <!--          FOOTER TEXT          -->
        <StackLayout Grid.Row="3"
                     HorizontalOptions="Center"
                     Margin="0,80,0,20">

            <VerticalStackLayout>
                <Label Text="Privacy Policy | Terms of Service" 
                       Style="{StaticResource LabelDefault}"
                       HorizontalTextAlignment="Center"/>
                <Label Text="{Binding Version, StringFormat='v1.0.4 Clinical Version | v{0} Applicaiton Version'}"
                       Style="{StaticResource LabelLight}" 
                       HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>
        </StackLayout>

    </Grid>
</ContentPage>