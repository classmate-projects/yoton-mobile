<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Yoton_Mobile.Pages.WelcomePage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{AppThemeBinding Light=#F4F7FF, Dark=#080B12}">

    <Grid RowDefinitions="*, Auto">

        <!-- HERO SECTION -->
        <Grid Grid.Row="0">
            <!-- Soft gradient hero backdrop -->
            <Border StrokeThickness="0" HorizontalOptions="Fill" VerticalOptions="Fill">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="{AppThemeBinding Light=#EBF0FF, Dark=#0D1428}" Offset="0"/>
                        <GradientStop Color="{AppThemeBinding Light=#F4F7FF, Dark=#080B12}" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Decorative orbs -->
            <Border x:Name="shape1" WidthRequest="220" HeightRequest="220"
                    StrokeThickness="0" Background="#150055CC"
                    StrokeShape="RoundRectangle 110"
                    HorizontalOptions="Start" VerticalOptions="Start"
                    Margin="-60,-50,0,0"/>
            <Border x:Name="shape2" WidthRequest="140" HeightRequest="140"
                    StrokeThickness="0" Background="#15008C8C"
                    StrokeShape="RoundRectangle 70"
                    HorizontalOptions="End" VerticalOptions="Center"
                    Margin="0,80,-40,0"/>

            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center"
                                 Padding="30,0" Spacing="30" x:Name="heroStack">

                <!-- Medical Illustration -->
                <Grid x:Name="illustrationGroup" HeightRequest="190" WidthRequest="190" HorizontalOptions="Center">
                    <!-- Outer pulse ring 1 -->
                    <Border StrokeThickness="1" Stroke="{StaticResource Primary-300}"
                            StrokeShape="RoundRectangle 95"
                            WidthRequest="190" HeightRequest="190"
                            HorizontalOptions="Center" VerticalOptions="Center"
                            Opacity="0.15"/>
                    <!-- Outer pulse ring 2 -->
                    <Border StrokeThickness="1.5" Stroke="{StaticResource Primary-500}"
                            StrokeShape="RoundRectangle 75"
                            WidthRequest="150" HeightRequest="150"
                            HorizontalOptions="Center" VerticalOptions="Center"
                            Opacity="0.2"/>
                    <!-- Center icon card -->
                    <Border WidthRequest="108" HeightRequest="108"
                            StrokeThickness="0"
                            Background="{AppThemeBinding Light=#FFFFFF, Dark=#141828}"
                            StrokeShape="RoundRectangle 54"
                            HorizontalOptions="Center" VerticalOptions="Center">
                        <Border.Shadow>
                            <Shadow Brush="#0055CC" Offset="0,8" Radius="22" Opacity="0.18"/>
                        </Border.Shadow>
                        <Image Source="app_logo" WidthRequest="66" HeightRequest="66"
                               Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                </Grid>

                <!-- Brand copy -->
                <VerticalStackLayout x:Name="headerStack" Opacity="0" Spacing="10" HorizontalOptions="Center">
                    <Label Text="Yoton Health"
                           FontFamily="PublicSansBold"
                           FontAttributes="Bold"
                           FontSize="36"
                           TextColor="{AppThemeBinding Light={StaticResource Primary-900}, Dark=White}"
                           HorizontalTextAlignment="Center"/>
                    <Label Text="Precision outpatient care,&#10;delivered through your fingertips."
                           FontFamily="NotoSansRegular"
                           FontSize="15"
                           TextColor="{AppThemeBinding Light={StaticResource Neutral-700}, Dark={StaticResource Neutral-300}}"
                           HorizontalTextAlignment="Center"
                           LineHeight="1.4"
                           Margin="10,0"/>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Grid>

        <!-- FOOTER ACTIONS -->
        <VerticalStackLayout Grid.Row="1" Padding="30,0,30,36" Spacing="20">

            <!-- WHAT YOU CAN DO -->
            <VerticalStackLayout x:Name="featuresStack" Opacity="0" Spacing="12">
                <HorizontalStackLayout Spacing="10">
                    <Label Text="📅" FontSize="16" VerticalOptions="Center"/>
                    <Label Text="Book &amp; manage appointments instantly" FontFamily="NotoSansRegular" FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource Neutral-700}, Dark={StaticResource Neutral-300}}"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="10">
                    <Label Text="🩺" FontSize="16" VerticalOptions="Center"/>
                    <Label Text="Consult your care team from anywhere" FontFamily="NotoSansRegular" FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource Neutral-700}, Dark={StaticResource Neutral-300}}"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="10">
                    <Label Text="💊" FontSize="16" VerticalOptions="Center"/>
                    <Label Text="Track prescriptions, labs &amp; records in one place" FontFamily="NotoSansRegular" FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource Neutral-700}, Dark={StaticResource Neutral-300}}"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Get Started gradient button -->
            <Border x:Name="getStartedWrap" StrokeThickness="0" Background="Transparent"
                    HorizontalOptions="Fill" Opacity="0">
                <Border.Shadow>
                    <Shadow Brush="#0055CC" Offset="0,8" Radius="16" Opacity="0.28"/>
                </Border.Shadow>
                <Button x:Name="getStartedBtn"
                        Clicked="OnGetStartedClicked"
                        Text="Get Started"
                        Command="{Binding LoginCommand}"
                        CornerRadius="16"
                        HeightRequest="54"
                        FontFamily="PublicSansBold"
                        FontAttributes="Bold"
                        FontSize="17"
                        TextColor="White">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{StaticResource Primary-700}" Offset="0.0"/>
                            <GradientStop Color="{StaticResource Secondary-500}" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>
            </Border>

            <!-- Clinical trust badges -->
            <Grid x:Name="badgesGrid" Opacity="0"
                  ColumnDefinitions="*, *" ColumnSpacing="12">
                <Border Grid.Column="0" Padding="10,10"
                        StrokeThickness="1" Stroke="#280055CC"
                        Background="{AppThemeBinding Light=#FFFFFF, Dark=#141828}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="🧬" FontSize="15" VerticalOptions="Center"/>
                        <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                            <Label Text="Clinical Grade" FontFamily="PublicSansBold" FontSize="11"
                                   TextColor="{AppThemeBinding Light={StaticResource Neutral-900}, Dark=White}"/>
                            <Label Text="ISO Certified" FontFamily="NotoSansLight" FontSize="9"
                                   TextColor="{StaticResource Neutral-500}"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Border>
                <Border Grid.Column="1" Padding="10,10"
                        StrokeThickness="1" Stroke="#28008C8C"
                        Background="{AppThemeBinding Light=#FFFFFF, Dark=#141828}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="🔒" FontSize="15" VerticalOptions="Center"/>
                        <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                            <Label Text="HIPAA Secure" FontFamily="PublicSansBold" FontSize="11"
                                   TextColor="{AppThemeBinding Light={StaticResource Neutral-900}, Dark=White}"/>
                            <Label Text="256-bit Encrypted" FontFamily="NotoSansLight" FontSize="9"
                                   TextColor="{StaticResource Neutral-500}"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <!-- Legal -->
            <Label Text="{Binding Version, StringFormat='Yoton Health v1.0.4 · App v{0}'}"
                   FontFamily="NotoSansLight"
                   FontSize="11"
                   TextColor="{StaticResource Neutral-500}"
                   HorizontalTextAlignment="Center"/>
        </VerticalStackLayout>
    </Grid>
</ContentPage>