<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Yoton_Mobile.Pages.HomePage"
             Title="HomePage">
    <VerticalStackLayout>
        <CollectionView ItemsSource="{Binding Patients}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="10" Padding="15" BorderColor="#cccccc" CornerRadius="10">
                        <VerticalStackLayout Spacing="6">

                            <Label Text="{Binding Name}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#333" />

                            <Label Text="{Binding Email}"
                                   FontSize="14"
                                   TextColor="#555" />

                            <Label Text="{Binding Phone}"
                                   FontSize="14"
                                   TextColor="#555" />

                            <Label Text="{Binding Address}"
                                   FontSize="14"
                                   TextColor="#555" />

                            <Label Text="{Binding DateOfBirth}"
                                   FontSize="14"
                                   TextColor="#777" />

                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>

            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>