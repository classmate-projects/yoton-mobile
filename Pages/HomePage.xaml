<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Yoton_Mobile.Controls"
             x:Class="Yoton_Mobile.Pages.HomePage"
             Title="Home Dashboard"
             BackgroundColor="{AppThemeBinding Light=#F5F7FA, Dark=#121417}">
    
    <Grid RowDefinitions="*, Auto">
    <ScrollView Grid.Row="0">
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- HEADER SECTION -->
            <Grid ColumnDefinitions="*, Auto" Margin="0,10,0,0">
                <VerticalStackLayout Grid.Column="0" Spacing="4">
                    <Label Text="Welcome back," 
                           Style="{StaticResource LabelLight}" 
                           FontSize="15" />
                    <Label Text="{Binding PatientName, StringFormat='{0} 👋'}" 
                           Style="{StaticResource H2}" 
                           FontAttributes="Bold" />
                    <Label Text="Here is your health status today." 
                           Style="{StaticResource LabelLight}" 
                           FontSize="13" />
                </VerticalStackLayout>
                
                <!-- The profile is shown once in Shell's side menu. -->
                <Button Grid.Column="1"
                        Text="☰"
                        FontSize="25"
                        TextColor="{StaticResource Primary-700}"
                        BackgroundColor="Transparent"
                        Padding="10,4"
                        Clicked="OnMenuClicked"
                        SemanticProperties.Description="Open profile and navigation menu" />
            </Grid>

            <!-- UPCOMING APPOINTMENTS CAROUSEL -->
            <Label Text="UPCOMING APPOINTMENTS"
                   TextColor="{StaticResource Primary-700}"
                   FontAttributes="Bold"
                   FontSize="12"
                   CharacterSpacing="1" />

            <CarouselView ItemsSource="{Binding UpcomingAppointments}"
                          IndicatorView="appointmentsIndicatorView"
                          PeekAreaInsets="24"
                          HeightRequest="200">
                <CarouselView.EmptyView>
                    <Border StrokeThickness="0"
                            Background="{AppThemeBinding Light=#FFFFFF, Dark=#1C1F23}"
                            Padding="20"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="8"
                                             HorizontalOptions="Center"
                                             VerticalOptions="Center">
                            <Label Text="📅"
                                   FontSize="32"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="No upcoming appointments"
                                   FontAttributes="Bold"
                                   FontSize="15"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="Tap Book Appointment below to schedule one."
                                   Style="{StaticResource LabelLight}"
                                   FontSize="13"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                </CarouselView.EmptyView>
                <CarouselView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeThickness="0"
                                Background="{AppThemeBinding Light=#FFFFFF, Dark=#1C1F23}"
                                Padding="20"
                                Margin="0,0,12,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#000000" Offset="0,4" Radius="10" Opacity="0.05" />
                            </Border.Shadow>

                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="*, Auto">
                                    <Label Text="{Binding Specialty}"
                                           TextColor="{StaticResource Primary-700}"
                                           FontAttributes="Bold"
                                           FontSize="12"
                                           CharacterSpacing="1" />
                                    <Border Grid.Column="1"
                                            BackgroundColor="{StaticResource Primary-100}"
                                            Padding="8,4"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 6">
                                        <Label Text="{Binding Status}"
                                               TextColor="{StaticResource Primary-900}"
                                               FontSize="11"
                                               FontAttributes="Bold"/>
                                    </Border>
                                </Grid>

                                <Label Text="{Binding DoctorName}"
                                       Style="{StaticResource H3}"
                                       FontAttributes="Bold" />

                                <BoxView Style="{StaticResource Divider}" Margin="0,5" />

                                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                                    <Label Text="📅" FontSize="16" VerticalOptions="Center"/>
                                    <Label Grid.Column="1"
                                           Text="{Binding Date, StringFormat='{0} '}"
                                           Style="{StaticResource LabelDefault}"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center"/>
                                </Grid>

                                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                                    <Label Text="⏰" FontSize="16" VerticalOptions="Center"/>
                                    <Label Grid.Column="1"
                                           Text="{Binding Time}"
                                           Style="{StaticResource LabelDefault}"
                                           VerticalOptions="Center"/>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CarouselView.ItemTemplate>
            </CarouselView>

            <IndicatorView x:Name="appointmentsIndicatorView"
                           IndicatorColor="{StaticResource Neutral-100}"
                           SelectedIndicatorColor="{StaticResource Primary-500}"
                           HorizontalOptions="Center" />

            <!-- ACTIVE MEDICATIONS -->
            <Label Text="Active Medications"
                   Style="{StaticResource H3}"
                   FontAttributes="Bold"
                   Margin="0,10,0,0" />

            <CollectionView ItemsSource="{Binding TodayTasks}">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="20" Spacing="4" HorizontalOptions="Center">
                        <Label Text="No active medications on file." Style="{StaticResource LabelLight}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeThickness="0"
                                Background="{AppThemeBinding Light=#FFFFFF, Dark=#1C1F23}"
                                Padding="15">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>

                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="15">
                                <Label Grid.Column="0"
                                       Text="💊"
                                       FontSize="20"
                                       VerticalOptions="Center" />

                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding Title}"
                                           FontAttributes="Bold"
                                           FontSize="15"
                                           TextColor="{AppThemeBinding Light={StaticResource Neutral-900}, Dark={StaticResource Neutral-100}}"/>
                                    <Label Text="{Binding Details}"
                                           Style="{StaticResource LabelLight}"
                                           FontSize="13"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- QUICK ACTIONS SECTION -->
            <Label Text="Quick Services" 
                   Style="{StaticResource H3}" 
                   FontAttributes="Bold" 
                   Margin="0,10,0,0" />

            <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" ColumnSpacing="12" RowSpacing="12">
                <!-- Action 1 -->
                <Border Grid.Row="0" Grid.Column="0" StrokeThickness="0"
                        Background="{AppThemeBinding Light=#FFFFFF, Dark=#1C1F23}" Padding="15">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBookAppointmentTapped" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="🩺" FontSize="26" HorizontalOptions="Center"/>
                        <Label Text="Book Appointment" FontAttributes="Bold" FontSize="13" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>
                
                <!-- Action 2 -->
                <Border Grid.Row="0" Grid.Column="1" StrokeThickness="0" 
                        Background="{AppThemeBinding Light=#FFFFFF, Dark=#1C1F23}" Padding="15">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="💊" FontSize="26" HorizontalOptions="Center"/>
                        <Label Text="Request Refill" FontAttributes="Bold" FontSize="13" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Action 3 -->
                <Border Grid.Row="1" Grid.Column="0" StrokeThickness="0" 
                        Background="{AppThemeBinding Light=#FFFFFF, Dark=#1C1F23}" Padding="15">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="💬" FontSize="26" HorizontalOptions="Center"/>
                        <Label Text="Message Doctor" FontAttributes="Bold" FontSize="13" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Action 4 -->
                <Border Grid.Row="1" Grid.Column="1" StrokeThickness="0" 
                        Background="{AppThemeBinding Light=#FFFFFF, Dark=#1C1F23}" Padding="15">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="📊" FontSize="26" HorizontalOptions="Center"/>
                        <Label Text="Log Vitals" FontAttributes="Bold" FontSize="13" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>

        <controls:GlassTabBar Grid.Row="1" SelectedRoute="home" />

        <!-- Calm medical animation, behind a frosted glass blur, while the dashboard is securely refreshed. -->
        <controls:GlassBusyOverlay Grid.RowSpan="2"
                                    IsRunning="{Binding IsBusy}"
                                    Message="Preparing your care dashboard" />
    </Grid>
</ContentPage>
