<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="clr-namespace:CommunityToolkit.Maui.Views;assembly=CommunityToolkit.Maui.MediaElement"
             x:Class="Yoton_Mobile.Pages.SplashVideoPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="White">

    <Grid>
        <Grid.GestureRecognizers>
            <!-- Tap anywhere to skip straight to the app. -->
            <TapGestureRecognizer Tapped="OnSkipTapped" />
        </Grid.GestureRecognizers>

        <toolkit:MediaElement x:Name="SplashVideo"
                               Aspect="AspectFill"
                               ShouldAutoPlay="True"
                               ShouldLoopPlayback="False"
                               ShouldShowPlaybackControls="False"
                               MediaEnded="OnMediaEnded"
                               MediaFailed="OnMediaFailed"
                               StateChanged="OnStateChanged" />

        <!-- Covers the black frame Android's video surface briefly shows when it is
             first attached to the window, before the first real video frame renders.
             Removed as soon as playback actually starts. -->
        <BoxView x:Name="SplashMask" Color="White" InputTransparent="True" />
    </Grid>
</ContentPage>
