<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Yoton_Mobile.Controls"
             x:Class="Yoton_Mobile.Pages.BiometricLockPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light=#F5F7FA, Dark=#121417}">

    <Grid RowDefinitions="*, Auto, Auto, Auto, *" Padding="30">

        <VerticalStackLayout Grid.Row="1" Spacing="24" HorizontalOptions="Center">
            <Label Text="{Binding UserName, StringFormat='Welcome back, {0}'}"
                   Style="{StaticResource H3}"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center" />

            <controls:MedicalBusyIndicator IsRunning="{Binding IsAuthenticating}"
                                            Message="{Binding StatusMessage}" />
        </VerticalStackLayout>

        <Button Grid.Row="2"
                Text="Unlock"
                Style="{StaticResource PrimaryButton}"
                Command="{Binding UnlockCommand}"
                IsEnabled="{Binding CanUnlock}"
                Margin="0,30,0,10" />

        <Button Grid.Row="3"
                Text="Use password instead"
                BackgroundColor="Transparent"
                TextColor="{StaticResource Primary-500}"
                Command="{Binding UsePasswordInsteadCommand}" />
    </Grid>
</ContentPage>
