<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Yoton_Mobile.Pages.SplashPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#0D0E11}">

    <Grid>
        <!-- BACKGROUND DECORATIONS (Floating Geometric Shapes) -->
        <Border x:Name="shape1" WidthRequest="180" HeightRequest="180" StrokeThickness="0" Background="#1A0A6CFF" StrokeShape="RoundRectangle 90" HorizontalOptions="Start" VerticalOptions="Start" Margin="-40,-40,0,0" Opacity="0.6"/>
        <Border x:Name="shape2" WidthRequest="220" HeightRequest="220" StrokeThickness="0" Background="#1A00E676" StrokeShape="RoundRectangle 110" HorizontalOptions="End" VerticalOptions="End" Margin="0,0,-60,-60" Opacity="0.5"/>
        <Border x:Name="shape3" WidthRequest="100" HeightRequest="100" StrokeThickness="0" Background="#1AFFE1CC" StrokeShape="RoundRectangle 50" HorizontalOptions="End" VerticalOptions="Start" Margin="0,80,40,0" Opacity="0.4"/>

        <!-- MAIN CENTER CONTENT -->
        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="25">
            <!-- Pulsing Glowing Logo Container -->
            <Border x:Name="logoContainer"
                    WidthRequest="120" HeightRequest="120"
                    StrokeThickness="0"
                    Background="{AppThemeBinding Light=#F0F4FF, Dark=#1A2238}"
                    StrokeShape="RoundRectangle 60"
                    HorizontalOptions="Center">
                <Border.Shadow>
                    <Shadow Brush="#0A6CFF" Offset="0,0" Radius="30" Opacity="0.3"/>
                </Border.Shadow>
                
                <Grid>
                    <!-- Glowing Outer Ring -->
                    <Border StrokeThickness="2" Stroke="#0A6CFF" StrokeShape="RoundRectangle 54" WidthRequest="108" HeightRequest="108" HorizontalOptions="Center" VerticalOptions="Center" Opacity="0.5"/>
                    <!-- Centered Clinical Symbol -->
                    <Label Text="✚"
                           TextColor="{StaticResource Primary-500}"
                           FontAttributes="Bold"
                           FontSize="42"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Brand Name & Description -->
            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                <Label Text="Yoton Health"
                       Style="{StaticResource H1}"
                       FontAttributes="Bold"
                       FontSize="36"
                       TextColor="{AppThemeBinding Light={StaticResource Primary-700}, Dark=White}"
                       HorizontalOptions="Center"/>
                
                <Label Text="OUTPATIENT PRECISION PORTAL"
                       TextColor="{StaticResource Primary-300}"
                       FontAttributes="Bold"
                       FontSize="11"
                       CharacterSpacing="2"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </VerticalStackLayout>

        <!-- ELEGANT LOADING INDICATOR -->
        <VerticalStackLayout VerticalOptions="End" HorizontalOptions="Center" Margin="0,0,0,60" Spacing="10">
            <ActivityIndicator IsRunning="True"
                               Color="{StaticResource Primary-500}"
                               WidthRequest="40"
                               HeightRequest="40" />
            <Label Text="Securing Clinical Connection..."
                   Style="{StaticResource LabelLight}"
                   FontSize="12"
                   HorizontalOptions="Center"/>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
