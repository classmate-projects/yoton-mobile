<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Yoton_Mobile.Pages.SplashPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Neutral-900}}">

    <Grid>
        <Grid.GestureRecognizers>
            <!-- Tap anywhere to skip straight to the app. -->
            <TapGestureRecognizer Tapped="OnSkipTapped" />
        </Grid.GestureRecognizers>

        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="18">
            <Image x:Name="LogoImage"
                   Source="app_logo"
                   WidthRequest="132" HeightRequest="132"
                   Opacity="0" Scale="0.7" />
            <Label x:Name="WordmarkLabel"
                   Text="Yoton Health"
                   FontFamily="PublicSansBold"
                   FontAttributes="Bold"
                   FontSize="26"
                   TextColor="{AppThemeBinding Light={StaticResource Primary-900}, Dark={StaticResource Primary-300}}"
                   Opacity="0" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
