<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Yoton_Mobile.Controls"
             xmlns:converters="clr-namespace:Yoton_Mobile.Converters"
             xmlns:behaviors="clr-namespace:Yoton_Mobile.Behaviors"
             x:Class="Yoton_Mobile.Pages.AppointmentsPage"
             x:Name="Root"
             Title="Appointments"
             BackgroundColor="{AppThemeBinding Light=#F5F7FA, Dark=#121417}">

    <ContentPage.Behaviors>
        <behaviors:DismissKeyboardBehavior />
    </ContentPage.Behaviors>

    <ContentPage.Resources>
        <converters:InvertedBoolConverter x:Key="InvertedBool" />
    </ContentPage.Resources>

    <Grid RowDefinitions="*, Auto, Auto">
        <!-- Main Scrollable List -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20" Spacing="20">

                <!-- Header -->
                <Grid ColumnDefinitions="*, Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="Your Appointments" Style="{StaticResource H2}" FontAttributes="Bold" />
                        <Label Text="Manage and track your doctor appointments and clinical consultations." Style="{StaticResource LabelLight}" />
                    </VerticalStackLayout>
                    <Border Grid.Column="1"
                            WidthRequest="42" HeightRequest="42"
                            StrokeThickness="0"
                            Background="{StaticResource Primary-500}"
                            VerticalOptions="Start">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="21" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ScheduleNewAppointmentCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="+" TextColor="White" FontSize="24" FontAttributes="Bold"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </Grid>

                <!-- INLINE "REQUEST AN APPOINTMENT" PANEL -->
                <Border IsVisible="{Binding IsBookingPanelOpen}"
                        StrokeThickness="1"
                        Stroke="{StaticResource Primary-100}"
                        Background="{AppThemeBinding Light=#F0F5FF, Dark=#111930}"
                        Padding="15">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="14">
                        <Label Text="Request an appointment" Style="{StaticResource H3}" FontAttributes="Bold" />
                        <Label Text="Pick up to 3 preferred doctors, then choose a date and time. The clinic will confirm your request."
                               Style="{StaticResource LabelLight}" FontSize="12" />

                        <!-- Specialization / department chips -->
                        <Label Text="Department" Style="{StaticResource LabelLight}" FontSize="12" />
                        <CollectionView ItemsSource="{Binding SpecializationNames}"
                                        SelectionMode="Single"
                                        SelectedItem="{Binding SelectedSpecializationName}"
                                        HeightRequest="44">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12,8" StrokeThickness="1" Stroke="{StaticResource Primary-100}">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="20" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding .}" FontSize="12" FontAttributes="Bold" />
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <ActivityIndicator IsRunning="{Binding IsLoadingDoctors}" IsVisible="{Binding IsLoadingDoctors}" />

                        <!-- Doctor carousel with basic info -->
                        <Label Text="Doctors" Style="{StaticResource LabelLight}" FontSize="12" />
                        <CarouselView ItemsSource="{Binding DoctorCards}" PeekAreaInsets="16" HeightRequest="160" Loop="False">
                            <CarouselView.EmptyView>
                                <Label Text="No doctors available in this department yet." Style="{StaticResource LabelLight}" FontSize="12" />
                            </CarouselView.EmptyView>
                            <CarouselView.ItemTemplate>
                                <DataTemplate>
                                    <Border StrokeThickness="0"
                                            Background="{AppThemeBinding Light=#FFFFFF, Dark=#1C1F23}"
                                            Padding="14" Margin="0,0,10,0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
                                            <Label Grid.Row="0" Text="{Binding Name}" FontAttributes="Bold" FontSize="15" />
                                            <Label Grid.Row="1" Text="{Binding SpecializationName}" Style="{StaticResource LabelLight}" FontSize="12" />
                                            <Label Grid.Row="2" Text="{Binding ExperienceYears, StringFormat='{0} years experience'}" FontSize="12" />
                                            <Button Grid.Row="3" Text="Prefer this doctor" FontSize="11" HeightRequest="34"
                                                    Command="{Binding Path=BindingContext.TogglePreferredDoctorCommand, Source={x:Reference Root}}"
                                                    CommandParameter="{Binding .}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CarouselView.ItemTemplate>
                        </CarouselView>

                        <!-- Ranked preferences -->
                        <Label Text="Your preferences (tap to remove, max 3)" Style="{StaticResource LabelLight}" FontSize="12" />
                        <CollectionView ItemsSource="{Binding PreferredDoctors}" HeightRequest="46">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.EmptyView>
                                <Label Text="No preferences selected yet." Style="{StaticResource LabelLight}" FontSize="12" />
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,6" StrokeThickness="1"
                                            Stroke="{StaticResource Primary-500}"
                                            BackgroundColor="{StaticResource Primary-100}">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="16" />
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Path=BindingContext.TogglePreferredDoctorCommand, Source={x:Reference Root}}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="{Binding Name}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Primary-900}" />
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <!-- Date -->
                        <Label Text="Date" Style="{StaticResource LabelLight}" FontSize="12" />
                        <DatePicker Date="{Binding SelectedBookingDate}" />

                        <ActivityIndicator IsRunning="{Binding IsLoadingSlots}" IsVisible="{Binding IsLoadingSlots}" />

                        <!-- Available slots (shared-slot aware) -->
                        <Label Text="Available slots" Style="{StaticResource LabelLight}" FontSize="12" />
                        <CollectionView ItemsSource="{Binding AvailableSlots}" SelectionMode="None">
                            <CollectionView.ItemsLayout>
                                <GridItemsLayout Orientation="Vertical" Span="3" HorizontalItemSpacing="8" VerticalItemSpacing="8" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.EmptyView>
                                <Label Text="No slots to show yet — pick a preferred doctor and date." Style="{StaticResource LabelLight}" FontSize="12" />
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8" StrokeThickness="1" Stroke="{StaticResource Neutral-100}">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10" />
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Path=BindingContext.SelectSlotCommand, Source={x:Reference Root}}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsPast}" Value="True">
                                                <Setter Property="Opacity" Value="0.4" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsAvailable}" Value="False">
                                                <Setter Property="BackgroundColor" Value="{StaticResource Neutral-100}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                            <Label Text="{Binding Start, StringFormat='{0:h:mm tt}'}" FontSize="12" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                                            <Label FontSize="9" Style="{StaticResource LabelLight}" HorizontalTextAlignment="Center">
                                                <Label.Text>
                                                    <MultiBinding StringFormat="{}{0}/{1} booked">
                                                        <Binding Path="BookedCount" />
                                                        <Binding Path="MaxCapacity" />
                                                    </MultiBinding>
                                                </Label.Text>
                                            </Label>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <!-- Notes -->
                        <Label Text="Notes (optional)" Style="{StaticResource LabelLight}" FontSize="12" />
                        <Editor Text="{Binding BookingNotes}" Placeholder="Reason for visit" HeightRequest="70" AutoSize="TextChanges" />

                        <Grid ColumnDefinitions="*, Auto">
                            <Button Grid.Column="0" Text="Send Request"
                                    Command="{Binding SubmitBookingRequestCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    IsEnabled="{Binding IsBookingSubmitting, Converter={StaticResource InvertedBool}}" />
                            <ActivityIndicator Grid.Column="1" Margin="10,0,0,0"
                                                IsRunning="{Binding IsBookingSubmitting}"
                                                IsVisible="{Binding IsBookingSubmitting}"
                                                Color="{StaticResource Primary-500}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- UPCOMING SECTION -->
                <Label Text="Upcoming Visits" Style="{StaticResource H3}" FontAttributes="Bold" Margin="0,10,0,0" />

                <!-- Gated on IsBusy so the "No upcoming appointments" empty view can't flash
                     before the first load actually returns data. -->
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Margin="0,10" />

                <CollectionView ItemsSource="{Binding UpcomingAppointments}"
                                IsVisible="{Binding IsBusy, Converter={StaticResource InvertedBool}}">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="20" Spacing="4" HorizontalOptions="Center">
                            <Label Text="No upcoming appointments." Style="{StaticResource LabelLight}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border StrokeThickness="0" Background="{AppThemeBinding Light=#FFFFFF, Dark=#1C1F23}" Padding="15">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <Label Text="{Binding DoctorName}" FontAttributes="Bold" FontSize="16" />
                                        <Label Grid.Column="1" Text="{Binding Status}" TextColor="{StaticResource Primary-500}" FontSize="12" FontAttributes="Bold">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Pending">
                                                    <Setter Property="TextColor" Value="{StaticResource Warning-500}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Completed">
                                                    <Setter Property="TextColor" Value="{StaticResource Success-500}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Cancelled">
                                                    <Setter Property="TextColor" Value="{StaticResource Neutral-500}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Grid>
                                    <Label Text="{Binding Specialty}" Style="{StaticResource LabelLight}" FontSize="13" Margin="0,-5,0,0" />
                                    
                                    <BoxView Style="{StaticResource Divider}" Margin="0,5" />
                                    
                                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                                        <HorizontalStackLayout Grid.Column="0" Spacing="5">
                                            <Label Text="📅" FontSize="14" VerticalOptions="Center"/>
                                            <Label Text="{Binding Date}" FontSize="13" VerticalOptions="Center"/>
                                        </HorizontalStackLayout>
                                        <HorizontalStackLayout Grid.Column="1" Spacing="5">
                                            <Label Text="⏰" FontSize="14" VerticalOptions="Center"/>
                                            <Label Text="{Binding Time}" FontSize="13" VerticalOptions="Center"/>
                                        </HorizontalStackLayout>
                                    </Grid>
                                    
                                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="5" Margin="0,5,0,0">
                                        <Label Text="📍" FontSize="14" VerticalOptions="Center"/>
                                        <Label Grid.Column="1" Text="{Binding Location}" Style="{StaticResource LabelLight}" FontSize="12" VerticalOptions="Center"/>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- PAST SECTION -->
                <Label Text="Past Visits" Style="{StaticResource H3}" FontAttributes="Bold" Margin="0,15,0,0" />

                <CollectionView ItemsSource="{Binding PastAppointments}"
                                IsVisible="{Binding IsBusy, Converter={StaticResource InvertedBool}}">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="20" Spacing="4" HorizontalOptions="Center">
                            <Label Text="No past visits yet." Style="{StaticResource LabelLight}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border StrokeThickness="0" Background="{AppThemeBinding Light=#FFFFFF, Dark=#1C1F23}" Padding="15" StrokeDashArray="2,2" Stroke="#E0E0E0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>

                                <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto" RowSpacing="4">
                                    <Label Grid.Row="0" Grid.Column="0" Text="{Binding DoctorName}" FontAttributes="Bold" FontSize="15" />
                                    <Label Grid.Row="0" Grid.Column="1" Text="{Binding Status}" TextColor="{StaticResource Neutral-500}" FontSize="11" FontAttributes="Bold">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Completed">
                                                <Setter Property="TextColor" Value="{StaticResource Success-500}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Label Grid.Row="1" Grid.Column="0" Text="{Binding Specialty}" Style="{StaticResource LabelLight}" FontSize="12" />
                                    
                                    <HorizontalStackLayout Grid.Row="2" Grid.Column="0" Spacing="15" Margin="0,5,0,0">
                                        <Label Text="{Binding Date}" FontSize="12" Style="{StaticResource LabelLight}"/>
                                        <Label Text="{Binding Location}" FontSize="12" Style="{StaticResource LabelLight}"/>
                                    </HorizontalStackLayout>

                                    <!-- Review Notes button -->
                                    <Button Grid.Row="1" Grid.RowSpan="2" Grid.Column="1"
                                            Text="Notes" FontSize="11"
                                            HeightRequest="30" Padding="10,0"
                                            BackgroundColor="{StaticResource Neutral-100}"
                                            TextColor="{StaticResource Neutral-900}"
                                            VerticalOptions="Center"
                                            Command="{Binding Path=BindingContext.ShowConsultationNotesCommand, Source={x:Reference Root}}"
                                            CommandParameter="{Binding .}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <!-- BOOK APPOINTMENT ACTION -->
        <Border Grid.Row="1" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C1F23}" Padding="15" StrokeThickness="1" Stroke="#E0E0E0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0" />
            </Border.StrokeShape>
            <Button Text="Schedule New Consultation"
                    Command="{Binding ScheduleNewAppointmentCommand}"
                    Style="{StaticResource PrimaryButton}"
                    HorizontalOptions="FillAndExpand">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsBookingPanelOpen}" Value="True">
                        <Setter Property="Text" Value="Close" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </Border>

        <controls:GlassTabBar Grid.Row="2" SelectedRoute="appointments" />
    </Grid>
</ContentPage>
