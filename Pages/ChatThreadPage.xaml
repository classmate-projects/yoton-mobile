<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:behaviors="clr-namespace:Yoton_Mobile.Behaviors"
             xmlns:models="clr-namespace:Yoton_Mobile.Models"
             xmlns:converters="clr-namespace:Yoton_Mobile.Converters"
             x:Class="Yoton_Mobile.Pages.ChatThreadPage"
             x:Name="Root"
             Title="{Binding Title}"
             BackgroundColor="{AppThemeBinding Light=#F5F7FA, Dark=#121417}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:StringNotEmptyConverter x:Key="StringNotEmpty" />
            <converters:IntGreaterThanZeroConverter x:Key="IntGreaterThanZero" />
            <converters:IsNotNullConverter x:Key="IsNotNull" />
            <converters:MultiEqualsConverter x:Key="MultiEquals" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Behaviors>
        <behaviors:DismissKeyboardBehavior />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto, *, Auto, Auto, Auto">

        <!-- PRESENCE + TYPING -->
        <VerticalStackLayout Grid.Row="0" Padding="15,6" Spacing="1">
            <HorizontalStackLayout Spacing="6" IsVisible="{Binding IsOtherOnline}">
                <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="{StaticResource Success-500}" />
                <Label Text="Online" FontSize="11" Style="{StaticResource LabelLight}" />
            </HorizontalStackLayout>
            <Label Text="{Binding TypingLabel}" FontSize="11" TextColor="{StaticResource Primary-500}"
                   IsVisible="{Binding TypingLabel, Converter={StaticResource StringNotEmpty}}" />
        </VerticalStackLayout>

        <!-- MESSAGE THREAD -->
        <CollectionView Grid.Row="1" ItemsSource="{Binding Messages}" Margin="15,5">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="15" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ChatMessageItem">
                    <VerticalStackLayout Spacing="4">
                        <Border Padding="14,10" StrokeThickness="0" MaximumWidthRequest="280">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>

                            <Border.Triggers>
                                <!-- Patient's own message (Right aligned, Blue) -->
                                <DataTrigger TargetType="Border" Binding="{Binding SenderType}" Value="Patient">
                                    <Setter Property="HorizontalOptions" Value="End" />
                                    <Setter Property="Background" Value="{StaticResource Primary-500}" />
                                </DataTrigger>
                                <!-- Doctor/Reception message (Left aligned, Gray/Dark) -->
                                <DataTrigger TargetType="Border" Binding="{Binding SenderType}" Value="User">
                                    <Setter Property="HorizontalOptions" Value="Start" />
                                    <Setter Property="Background" Value="{AppThemeBinding Light=#E5E7EB, Dark=#2A2E33}" />
                                </DataTrigger>
                            </Border.Triggers>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer NumberOfTapsRequired="2"
                                    Command="{Binding Path=BindingContext.ToggleReactionPickerCommand, Source={x:Reference Root}}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding Path=BindingContext.Conversation.OtherName, Source={x:Reference Root}}"
                                       FontSize="11" FontAttributes="Bold">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding SenderType}" Value="Patient">
                                            <Setter Property="IsVisible" Value="False" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding SenderType}" Value="User">
                                            <Setter Property="TextColor" Value="{StaticResource Primary-700}" />
                                            <Setter Property="IsVisible" Value="True" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>

                                <!-- Reply preview -->
                                <Border IsVisible="{Binding ReplyToPreview, Converter={StaticResource StringNotEmpty}}"
                                        Padding="8,4" StrokeThickness="0" Opacity="0.75"
                                        BackgroundColor="#22000000">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="6" />
                                    </Border.StrokeShape>
                                    <Label Text="{Binding ReplyToPreview}" FontSize="11" LineBreakMode="TailTruncation" />
                                </Border>

                                <Label Text="{Binding Content}" FontSize="14" IsVisible="{Binding Content, Converter={StaticResource StringNotEmpty}}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding SenderType}" Value="Patient">
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding SenderType}" Value="User">
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light=#111827, Dark=#F9FAFB}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>

                                <!-- Attachments -->
                                <CollectionView ItemsSource="{Binding Attachments}" IsVisible="{Binding Attachments.Count, Converter={StaticResource IntGreaterThanZero}}">
                                    <CollectionView.ItemsLayout>
                                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="4" />
                                    </CollectionView.ItemsLayout>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="models:ChatAttachment">
                                            <Border Padding="8,6" StrokeThickness="0" BackgroundColor="#22000000">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="8" />
                                                </Border.StrokeShape>
                                                <Label Text="{Binding FileName}" FontSize="12" LineBreakMode="TailTruncation" />
                                            </Border>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>

                                <!-- Reactions -->
                                <FlexLayout IsVisible="{Binding Reactions.Count, Converter={StaticResource IntGreaterThanZero}}"
                                            Wrap="Wrap" JustifyContent="Start">
                                    <BindableLayout.ItemsSource>
                                        <Binding Path="Reactions" />
                                    </BindableLayout.ItemsSource>
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:ChatReactionSummary">
                                            <Border Padding="6,2" Margin="0,2,4,0" StrokeThickness="1"
                                                    Stroke="Transparent" BackgroundColor="#22000000">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="10" />
                                                </Border.StrokeShape>
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border" Binding="{Binding ReactedByMe}" Value="True">
                                                        <Setter Property="Stroke" Value="{StaticResource Primary-500}" />
                                                        <Setter Property="BackgroundColor" Value="#220A6CFF" />
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <Label FontSize="11">
                                                    <Label.Text>
                                                        <MultiBinding StringFormat="{}{0} {1}">
                                                            <Binding Path="Emoji" />
                                                            <Binding Path="Count" />
                                                        </MultiBinding>
                                                    </Label.Text>
                                                </Label>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Emoji row: only visible for the one message currently toggled open -->
                        <HorizontalStackLayout Spacing="6" Margin="5,0">
                            <HorizontalStackLayout.IsVisible>
                                <MultiBinding Converter="{StaticResource MultiEquals}">
                                    <Binding Path="BindingContext.ReactionPickerMessageId" Source="{x:Reference Root}" />
                                    <Binding Path="ChatMessageId" />
                                </MultiBinding>
                            </HorizontalStackLayout.IsVisible>
                            <BindableLayout.ItemsSource>
                                <Binding Path="BindingContext.ReactionEmojis" Source="{x:Reference Root}" />
                            </BindableLayout.ItemsSource>
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Label Text="{Binding .}" FontSize="18">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Path=BindingContext.PickEmojiCommand, Source={x:Reference Root}}"
                                                CommandParameter="{Binding .}" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>

                        <!-- React / Reply actions - always visible under each bubble -->
                        <HorizontalStackLayout Spacing="14" Margin="5,0">
                            <Label Text="React" FontSize="11" TextColor="{StaticResource Primary-500}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Path=BindingContext.ToggleReactionPickerCommand, Source={x:Reference Root}}"
                                        CommandParameter="{Binding .}" />
                                </Label.GestureRecognizers>
                            </Label>

                            <Label Text="Reply" FontSize="11" TextColor="{StaticResource Primary-500}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Path=BindingContext.ReplyCommand, Source={x:Reference Root}}"
                                        CommandParameter="{Binding .}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>

                        <Label Text="{Binding CreatedAt, StringFormat='{0:MMM d, h:mm tt}'}" FontSize="10"
                               Style="{StaticResource LabelLight}" Margin="5,0">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding SenderType}" Value="Patient">
                                    <Setter Property="HorizontalOptions" Value="End" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding SenderType}" Value="User">
                                    <Setter Property="HorizontalOptions" Value="Start" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- REPLY BAR -->
        <Grid Grid.Row="2" ColumnDefinitions="*, Auto" Padding="15,6"
              IsVisible="{Binding ReplyingTo, Converter={StaticResource IsNotNull}}"
              BackgroundColor="{AppThemeBinding Light=#EFF3F8, Dark=#1A1D21}">
            <Label Grid.Column="0" FontSize="12" Style="{StaticResource LabelLight}" LineBreakMode="TailTruncation">
                <Label.Text>
                    <MultiBinding StringFormat="Replying to: {0}">
                        <Binding Path="ReplyingTo.Content" />
                    </MultiBinding>
                </Label.Text>
            </Label>
            <Label Grid.Column="1" Text="✕" FontSize="12">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CancelReplyCommand}" />
                </Label.GestureRecognizers>
            </Label>
        </Grid>

        <!-- STAGED ATTACHMENTS -->
        <CollectionView Grid.Row="3" ItemsSource="{Binding PendingFiles}" HeightRequest="34"
                         IsVisible="{Binding PendingFiles.Count, Converter={StaticResource IntGreaterThanZero}}"
                         Margin="15,4">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="8,4" StrokeThickness="1" Stroke="{StaticResource Neutral-100}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="{Binding FileName}" FontSize="11" />
                            <Label Text="✕" FontSize="11">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Path=BindingContext.RemovePendingFileCommand, Source={x:Reference Root}}"
                                        CommandParameter="{Binding .}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- COMPOSER -->
        <Border Grid.Row="4"
                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C1F23}"
                Padding="10,12"
                StrokeThickness="1"
                Stroke="#E0E0E0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0" />
            </Border.StrokeShape>

            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="8">
                <Label Grid.Column="0" Text="📎" FontSize="20" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding PickAttachmentCommand}" />
                    </Label.GestureRecognizers>
                </Label>

                <Entry Grid.Column="1"
                       Text="{Binding NewMessageText}"
                       Placeholder="Type a secure message..."
                       VerticalOptions="Center"
                       Keyboard="Chat"
                       ReturnCommand="{Binding SendMessageCommand}"
                       HeightRequest="42" />

                <Button Grid.Column="2"
                        Text="Send"
                        Command="{Binding SendMessageCommand}"
                        Style="{StaticResource PrimaryButton}"
                        WidthRequest="70"
                        HeightRequest="42"
                        Padding="0"
                        VerticalOptions="Center" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
