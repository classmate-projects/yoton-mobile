<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Yoton_Mobile.Controls"
             x:Class="Yoton_Mobile.Pages.MorePage"
             Title="More"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{AppThemeBinding Light=#F5F7FA, Dark=#121417}">

    <Grid RowDefinitions="*, Auto">
    <ScrollView Grid.Row="0">
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Header -->
            <VerticalStackLayout Spacing="4">
                <Label Text="More" Style="{StaticResource H2}" FontAttributes="Bold" />
                <Label Text="Your profile, wellbeing tools, and account settings." Style="{StaticResource LabelLight}" />
            </VerticalStackLayout>

            <!-- PROFILE HEADER -->
            <Border StrokeThickness="0" Background="{StaticResource Primary-700}" Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>

                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="15">
                    <Border WidthRequest="56" HeightRequest="56"
                            StrokeThickness="0"
                            Background="White"
                            StrokeShape="RoundRectangle 28"
                            VerticalOptions="Center">
                        <Label Text="{Binding UserInitials}"
                               TextColor="{StaticResource Primary-700}"
                               FontAttributes="Bold"
                               FontSize="22"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="{Binding UserName}" TextColor="White" FontAttributes="Bold" FontSize="17" />
                        <Label Text="{Binding UserRole}" TextColor="{StaticResource Primary-100}" FontSize="13" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- NAVIGATION LIST -->
            <Border StrokeThickness="0" Background="{AppThemeBinding Light=#FFFFFF, Dark=#1C1F23}" Padding="5">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>

                <VerticalStackLayout>
                    <Grid ColumnDefinitions="Auto, *, Auto" Padding="15" ColumnSpacing="15">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToPatientPerspectiveCommand}" />
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0" Text="🧭" FontSize="20" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="Patient Perspective" FontAttributes="Bold" FontSize="15" />
                            <Label Text="Track your mood, pain, water and steps" Style="{StaticResource LabelLight}" FontSize="12" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="20" TextColor="{StaticResource Neutral-300}" VerticalOptions="Center" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{StaticResource Neutral-100}" Margin="15,0" />

                    <Grid ColumnDefinitions="Auto, *, Auto" Padding="15" ColumnSpacing="15">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToSupportCommand}" />
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0" Text="🤝" FontSize="20" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="Support &amp; Care Circle" FontAttributes="Bold" FontSize="15" />
                            <Label Text="Contact the clinic or manage your care circle" Style="{StaticResource LabelLight}" FontSize="12" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="20" TextColor="{StaticResource Neutral-300}" VerticalOptions="Center" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{StaticResource Neutral-100}" Margin="15,0" />

                    <Grid ColumnDefinitions="Auto, *, Auto" Padding="15" ColumnSpacing="15">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToSettingsCommand}" />
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0" Text="⚙️" FontSize="20" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="Settings" FontAttributes="Bold" FontSize="15" />
                            <Label Text="Preferences, security, and logout" Style="{StaticResource LabelLight}" FontSize="12" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="20" TextColor="{StaticResource Neutral-300}" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

        <controls:GlassTabBar Grid.Row="1" SelectedRoute="more" />
    </Grid>
</ContentPage>
