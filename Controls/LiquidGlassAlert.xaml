<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Yoton_Mobile.Controls.LiquidGlassAlert"
             x:Name="Root"
             IsVisible="False"
             Opacity="0"
             SemanticProperties.Description="Yoton Health notification">
    <Grid BackgroundColor="#87040B1B" Padding="24">
        <!-- Oversized translucent layers simulate refraction behind the dialog. -->
        <Border WidthRequest="280" HeightRequest="280" HorizontalOptions="Start" VerticalOptions="Start"
                TranslationX="-120" TranslationY="-130" Background="#300A6CFF" StrokeThickness="0"
                StrokeShape="RoundRectangle 140" />
        <Border WidthRequest="220" HeightRequest="220" HorizontalOptions="End" VerticalOptions="End"
                TranslationX="100" TranslationY="120" Background="#2600D1C6" StrokeThickness="0"
                StrokeShape="RoundRectangle 110" />

        <Border x:Name="GlassCard"
                MaximumWidthRequest="390" Padding="24"
                HorizontalOptions="Fill" VerticalOptions="Center"
                Stroke="#A6FFFFFF" StrokeThickness="1.2"
                StrokeShape="RoundRectangle 30">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#F2F9FDFF" Offset="0" />
                    <GradientStop Color="#D6E5F7FF" Offset="0.55" />
                    <GradientStop Color="#C6C9F4F6" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Shadow>
                <Shadow Brush="#A000315C" Offset="0,16" Radius="30" Opacity="0.38" />
            </Border.Shadow>
            <Grid RowDefinitions="Auto, Auto, Auto, Auto" RowSpacing="16">
                <!-- Reflected highlight -->
                <Border HeightRequest="46" Margin="8,-18,8,0" Opacity="0.5" StrokeThickness="0"
                        VerticalOptions="Start" StrokeShape="RoundRectangle 18">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#BFFFFFFF" Offset="0" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Grid Grid.Row="0" WidthRequest="70" HeightRequest="70" HorizontalOptions="Center">
                    <Border WidthRequest="70" HeightRequest="70" Background="#3000AFAF" Stroke="#7500C6C6"
                            StrokeThickness="1" StrokeShape="RoundRectangle 35">
                        <Border.Shadow>
                            <Shadow Brush="#7C00E8E8" Offset="0,0" Radius="16" Opacity="0.9" />
                        </Border.Shadow>
                    </Border>
                    <Image Source="app_logo" WidthRequest="42" HeightRequest="42"
                           Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" />
                </Grid>

                <VerticalStackLayout Grid.Row="1" Spacing="8">
                    <Label Text="{Binding Title, Source={x:Reference Root}}" FontFamily="PublicSansBold"
                           FontSize="22" TextColor="#073B73" HorizontalTextAlignment="Center" />
                    <Label Text="{Binding Message, Source={x:Reference Root}}" FontFamily="NotoSansRegular"
                           FontSize="14" LineHeight="1.35" TextColor="#37516E" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <Border Grid.Row="2" HeightRequest="1" Background="#3B007CC4" StrokeThickness="0" />

                <Grid Grid.Row="3" ColumnDefinitions="*, *" ColumnSpacing="12">
                    <Button x:Name="CancelButton" Grid.Column="0" Text="{Binding CancelText, Source={x:Reference Root}}"
                            Clicked="OnCancelClicked" FontFamily="PublicSansBold" FontSize="14"
                            TextColor="#07569E" BackgroundColor="#5CFFFFFF" CornerRadius="15"
                            HeightRequest="48" IsVisible="{Binding HasCancelAction, Source={x:Reference Root}}" />
                    <Button x:Name="ConfirmButton" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding ConfirmText, Source={x:Reference Root}}"
                            Clicked="OnConfirmClicked" FontFamily="PublicSansBold" FontSize="14"
                            TextColor="White" CornerRadius="15" HeightRequest="48">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#0A6CFF" Offset="0" />
                                <GradientStop Color="#008C8C" Offset="1" />
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</ContentView>
