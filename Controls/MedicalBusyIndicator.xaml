<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Yoton_Mobile.Controls.MedicalBusyIndicator"
             x:Name="Root"
             WidthRequest="176"
             HeightRequest="184"
             SemanticProperties.Description="Yoton Health is loading your care information">
    <VerticalStackLayout Spacing="12" HorizontalOptions="Center" VerticalOptions="Center">
        <Grid x:Name="IndicatorCanvas" WidthRequest="132" HeightRequest="132">
            <Border x:Name="OuterHalo"
                    WidthRequest="124" HeightRequest="124"
                    HorizontalOptions="Center" VerticalOptions="Center"
                    Stroke="#380A6CFF" StrokeThickness="1"
                    Background="#090A6CFF"
                    StrokeShape="RoundRectangle 62" />
            <Border x:Name="InnerHalo"
                    WidthRequest="94" HeightRequest="94"
                    HorizontalOptions="Center" VerticalOptions="Center"
                    Stroke="#42008C8C" StrokeThickness="1.5"
                    Background="#0B00C6C6"
                    StrokeShape="RoundRectangle 47" />

            <!-- Rotating clinical accent -->
            <Border x:Name="Orbit"
                    WidthRequest="124" HeightRequest="124"
                    HorizontalOptions="Center" VerticalOptions="Center"
                    StrokeThickness="0" Background="Transparent">
                <Border StrokeThickness="0"
                        WidthRequest="10" HeightRequest="10"
                        Background="#51F6FF"
                        StrokeShape="RoundRectangle 5"
                        HorizontalOptions="End" VerticalOptions="Start">
                    <Border.Shadow>
                        <Shadow Brush="#69E6FFFF" Offset="0,0" Radius="8" Opacity="0.95" />
                    </Border.Shadow>
                </Border>
            </Border>

            <!-- Glass capsule with a heartbeat trace -->
            <Border x:Name="Capsule"
                    WidthRequest="70" HeightRequest="70"
                    HorizontalOptions="Center" VerticalOptions="Center"
                    Stroke="#80FFFFFF" StrokeThickness="1"
                    StrokeShape="RoundRectangle 35">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#F2FFFFFF" Offset="0" />
                        <GradientStop Color="#B8DDF9FF" Offset="0.55" />
                        <GradientStop Color="#B5008C8C" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Shadow>
                    <Shadow Brush="#590055CC" Offset="0,6" Radius="14" Opacity="0.5" />
                </Border.Shadow>
                <Grid Padding="13">
                    <Path Stroke="#0055CC" StrokeThickness="2.2" StrokeLineCap="Round" StrokeLineJoin="Round"
                          Data="M 1,23 L 13,23 L 19,13 L 27,35 L 35,18 L 40,23 L 55,23" />
                    <Border WidthRequest="7" HeightRequest="7" Background="#67FAFF" StrokeThickness="0"
                            StrokeShape="RoundRectangle 4" HorizontalOptions="End" VerticalOptions="Start">
                        <Border.Shadow>
                            <Shadow Brush="#C8F6FFFF" Offset="0,0" Radius="6" Opacity="1" />
                        </Border.Shadow>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
            <Label Text="{Binding Message, Source={x:Reference Root}}"
                   FontFamily="PublicSansBold" FontSize="13" TextColor="#0055CC"
                   HorizontalTextAlignment="Center" />
            <Label Text="Securely syncing your care" FontFamily="NotoSansRegular" FontSize="10"
                   TextColor="#62748B" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </VerticalStackLayout>
</ContentView>
