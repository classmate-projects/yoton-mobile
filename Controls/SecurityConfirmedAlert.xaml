<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Yoton_Mobile.Controls.SecurityConfirmedAlert"
             x:Name="Root"
             IsVisible="False"
             Opacity="0"
             SemanticProperties.Description="Password updated — account secured">
    <Grid BackgroundColor="#87040B1B" Padding="24">
        <!-- Oversized translucent layers simulate refraction behind the dialog. -->
        <Border WidthRequest="280" HeightRequest="280" HorizontalOptions="Start" VerticalOptions="Start"
                TranslationX="-120" TranslationY="-130" Background="#3016C79A" StrokeThickness="0"
                StrokeShape="RoundRectangle 140" />
        <Border WidthRequest="220" HeightRequest="220" HorizontalOptions="End" VerticalOptions="End"
                TranslationX="100" TranslationY="120" Background="#2600D1C6" StrokeThickness="0"
                StrokeShape="RoundRectangle 110" />

        <Border x:Name="GlassCard"
                MaximumWidthRequest="390" Padding="24"
                HorizontalOptions="Fill" VerticalOptions="Center"
                Stroke="#A6FFFFFF" StrokeThickness="1.2"
                StrokeShape="RoundRectangle 30">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#F2FDF7FF" Offset="0" />
                    <GradientStop Color="#D6F7E9FF" Offset="0.55" />
                    <GradientStop Color="#C6F4EFF6" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Shadow>
                <Shadow Brush="#A000315C" Offset="0,16" Radius="30" Opacity="0.38" />
            </Border.Shadow>
            <Grid RowDefinitions="Auto, Auto, Auto, Auto" RowSpacing="16">
                <!-- Reflected highlight -->
                <Border HeightRequest="46" Margin="8,-18,8,0" Opacity="0.5" StrokeThickness="0"
                        VerticalOptions="Start" StrokeShape="RoundRectangle 18">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#BFFFFFFF" Offset="0" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Grid Grid.Row="0" WidthRequest="96" HeightRequest="96" HorizontalOptions="Center">
                    <!-- Expanding pulse ring, played once the badge has settled -->
                    <Border x:Name="PulseRing" WidthRequest="70" HeightRequest="70" Background="Transparent"
                            Stroke="#4016C79A" StrokeThickness="2" StrokeShape="RoundRectangle 35"
                            HorizontalOptions="Center" VerticalOptions="Center" Opacity="0" />
                    <Border x:Name="ShieldBadge" WidthRequest="70" HeightRequest="70" Background="#3016C79A" Stroke="#7516C79A"
                            StrokeThickness="1" StrokeShape="RoundRectangle 35"
                            HorizontalOptions="Center" VerticalOptions="Center">
                        <Border.Shadow>
                            <Shadow Brush="#7C16C79A" Offset="0,0" Radius="16" Opacity="0.9" />
                        </Border.Shadow>
                    </Border>
                    <Label Text="&#128737;" FontSize="34" HorizontalOptions="Center" VerticalOptions="Center" />
                </Grid>

                <VerticalStackLayout Grid.Row="1" Spacing="8">
                    <Label Text="You're Fully Protected" FontFamily="PublicSansBold"
                           FontSize="22" TextColor="#0B5C3F" HorizontalTextAlignment="Center" />
                    <Label Text="{Binding Message, Source={x:Reference Root}}" FontFamily="NotoSansRegular"
                           FontSize="14" LineHeight="1.35" TextColor="#37516E" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <Border Grid.Row="2" HeightRequest="1" Background="#3B16C79A" StrokeThickness="0" />

                <Button Grid.Row="3" x:Name="ConfirmButton" Text="Continue"
                        Clicked="OnConfirmClicked" FontFamily="PublicSansBold" FontSize="14"
                        TextColor="White" CornerRadius="15" HeightRequest="48">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#16C79A" Offset="0" />
                            <GradientStop Color="#0A9CFF" Offset="1" />
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>
            </Grid>
        </Border>
    </Grid>
</ContentView>
