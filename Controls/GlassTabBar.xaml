<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Yoton_Mobile.Controls.GlassTabBar"
             x:Name="Root"
             SemanticProperties.Description="Main navigation">
    <Border Margin="16,0,16,14" Padding="10" HeightRequest="68"
            HorizontalOptions="Fill" VerticalOptions="End"
            Stroke="#8CFFFFFF" StrokeThickness="1.2"
            StrokeShape="RoundRectangle 30">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#E6FFFFFF" Offset="0" />
                <GradientStop Color="#CCE7F3FF" Offset="0.55" />
                <GradientStop Color="#BFDDF2F0" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.Shadow>
            <Shadow Brush="#4000315C" Offset="0,10" Radius="22" Opacity="0.3" />
        </Border.Shadow>

        <Grid ColumnDefinitions="*, *, *, *">
            <!-- HOME -->
            <Grid Grid.Column="0">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnHomeTapped" />
                </Grid.GestureRecognizers>
                <Border x:Name="HomePill" WidthRequest="46" HeightRequest="46" IsVisible="False"
                        HorizontalOptions="Center" VerticalOptions="Center"
                        StrokeThickness="0" StrokeShape="RoundRectangle 23">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{StaticResource Primary-500}" Offset="0" />
                            <GradientStop Color="{StaticResource Secondary-500}" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Shadow>
                        <Shadow Brush="#660A6CFF" Offset="0,4" Radius="10" Opacity="0.6" />
                    </Border.Shadow>
                </Border>
                <Image x:Name="HomeIcon" Source="tab_home.svg" WidthRequest="22" HeightRequest="22"
                       HorizontalOptions="Center" VerticalOptions="Center" Opacity="0.5" />
            </Grid>

            <!-- APPOINTMENTS -->
            <Grid Grid.Column="1">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAppointmentsTapped" />
                </Grid.GestureRecognizers>
                <Border x:Name="AppointmentsPill" WidthRequest="46" HeightRequest="46" IsVisible="False"
                        HorizontalOptions="Center" VerticalOptions="Center"
                        StrokeThickness="0" StrokeShape="RoundRectangle 23">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{StaticResource Primary-500}" Offset="0" />
                            <GradientStop Color="{StaticResource Secondary-500}" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Shadow>
                        <Shadow Brush="#660A6CFF" Offset="0,4" Radius="10" Opacity="0.6" />
                    </Border.Shadow>
                </Border>
                <Image x:Name="AppointmentsIcon" Source="tab_calendar.svg" WidthRequest="22" HeightRequest="22"
                       HorizontalOptions="Center" VerticalOptions="Center" Opacity="0.5" />
            </Grid>

            <!-- RECORDS -->
            <Grid Grid.Column="2">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnRecordsTapped" />
                </Grid.GestureRecognizers>
                <Border x:Name="RecordsPill" WidthRequest="46" HeightRequest="46" IsVisible="False"
                        HorizontalOptions="Center" VerticalOptions="Center"
                        StrokeThickness="0" StrokeShape="RoundRectangle 23">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{StaticResource Primary-500}" Offset="0" />
                            <GradientStop Color="{StaticResource Secondary-500}" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Shadow>
                        <Shadow Brush="#660A6CFF" Offset="0,4" Radius="10" Opacity="0.6" />
                    </Border.Shadow>
                </Border>
                <Image x:Name="RecordsIcon" Source="tab_records.svg" WidthRequest="22" HeightRequest="22"
                       HorizontalOptions="Center" VerticalOptions="Center" Opacity="0.5" />
            </Grid>

            <!-- MESSAGES -->
            <Grid Grid.Column="3">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnMessagesTapped" />
                </Grid.GestureRecognizers>
                <Border x:Name="MessagesPill" WidthRequest="46" HeightRequest="46" IsVisible="False"
                        HorizontalOptions="Center" VerticalOptions="Center"
                        StrokeThickness="0" StrokeShape="RoundRectangle 23">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{StaticResource Primary-500}" Offset="0" />
                            <GradientStop Color="{StaticResource Secondary-500}" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Shadow>
                        <Shadow Brush="#660A6CFF" Offset="0,4" Radius="10" Opacity="0.6" />
                    </Border.Shadow>
                </Border>
                <Image x:Name="MessagesIcon" Source="tab_messages.svg" WidthRequest="22" HeightRequest="22"
                       HorizontalOptions="Center" VerticalOptions="Center" Opacity="0.5" />
            </Grid>
        </Grid>
    </Border>
</ContentView>
