<?xml version="1.0" encoding="utf-8" ?>
<Shell
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:Yoton_Mobile.Pages"
    x:Class="Yoton_Mobile.AppShell"
    FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False"
    Shell.TabBarBackgroundColor="White"
    Shell.TabBarForegroundColor="{StaticResource Primary-500}"
    Shell.TabBarUnselectedColor="{StaticResource Neutral-300}">

    <!-- Main Navigation: native tab bar is hidden; each tab page hosts its own GlassTabBar instead.
         All 5 top-level destinations live under one TabBar so they're reachable from a single,
         consistent, always-visible bottom bar (no flyout) — Settings/Support/Patient Perspective
         used to be flyout-only pages with no way back except swiping; they're now pushed from the
         "More" tab and get Shell's native back button for free. -->
    <TabBar Route="dashboard">
        <Tab Title="" Icon="tab_home.svg" Route="home">
            <ShellContent ContentTemplate="{DataTemplate pages:HomePage}" Shell.NavBarIsVisible="False" Shell.TabBarIsVisible="False" />
        </Tab>
        <Tab Title="" Icon="tab_calendar.svg" Route="appointments">
            <ShellContent ContentTemplate="{DataTemplate pages:AppointmentsPage}" Shell.NavBarIsVisible="False" Shell.TabBarIsVisible="False" />
        </Tab>
        <Tab Title="" Icon="tab_records.svg" Route="records">
            <ShellContent ContentTemplate="{DataTemplate pages:RecordsPage}" Shell.NavBarIsVisible="False" Shell.TabBarIsVisible="False" />
        </Tab>
        <Tab Title="" Icon="tab_messages.svg" Route="messages">
            <ShellContent ContentTemplate="{DataTemplate pages:MessagesPage}" Shell.NavBarIsVisible="False" Shell.TabBarIsVisible="False" />
        </Tab>
        <Tab Title="" Icon="tab_more.svg" Route="more">
            <ShellContent ContentTemplate="{DataTemplate pages:MorePage}" Shell.NavBarIsVisible="False" Shell.TabBarIsVisible="False" />
        </Tab>
    </TabBar>

</Shell>
